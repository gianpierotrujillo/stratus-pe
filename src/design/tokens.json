{
  "$description": "FUENTE ÚNICA DE VERDAD VISUAL de Stratus Consulting. Todo el sitio (CSS, manifest, imágenes OG, correos) lee estos valores. Tras editar: se regenera solo al correr `npm run dev` o `npm run build`.",

  "color": {
    "$description": "Nivel 1 — colores primitivos de marca. Nunca se usan directo en componentes; se consumen a través de 'tone'.",
    "ink": "#0F1A25",
    "navy": "#1C3354",
    "gold": "#C29E43",
    "gold-deep": "#7E662B",
    "mist": "#F2F5F8",
    "white": "#FFFFFF",
    "slate": "#7890A8",
    "steel": "#46525F",
    "fog": "#AEB8C4"
  },

  "tone": {
    "$description": "Nivel 2 — colores semánticos. Los componentes SOLO usan estos nombres. Cada sección elige su tono con data-tone='light' | 'dark' | 'navy' y los valores cambian solos.",
    "light": {
      "surface": "{color.mist}",
      "surface-raised": "{color.white}",
      "heading": "{color.ink}",
      "body": "{color.steel}",
      "muted": "{color.steel}",
      "accent": "{color.gold}",
      "accent-text": "{color.gold-deep}",
      "on-accent": "{color.ink}",
      "line": "color-mix(in srgb, {color.ink} 14%, transparent)",
      "line-strong": "{color.gold}",
      "focus": "{color.navy}"
    },
    "dark": {
      "surface": "{color.ink}",
      "surface-raised": "color-mix(in srgb, {color.white} 4%, {color.ink})",
      "heading": "{color.mist}",
      "body": "{color.fog}",
      "muted": "{color.slate}",
      "accent": "{color.gold}",
      "accent-text": "{color.gold}",
      "on-accent": "{color.ink}",
      "line": "color-mix(in srgb, {color.mist} 14%, transparent)",
      "line-strong": "{color.gold}",
      "focus": "{color.gold}"
    },
    "navy": {
      "surface": "{color.navy}",
      "surface-raised": "color-mix(in srgb, {color.white} 6%, {color.navy})",
      "heading": "{color.mist}",
      "body": "{color.fog}",
      "muted": "{color.fog}",
      "accent": "{color.gold}",
      "accent-text": "{color.gold}",
      "on-accent": "{color.ink}",
      "line": "color-mix(in srgb, {color.mist} 18%, transparent)",
      "line-strong": "{color.gold}",
      "focus": "{color.gold}"
    }
  },

  "font": {
    "$description": "Las familias se cargan en src/design/fonts.ts (next/font). Aquí solo se asignan roles.",
    "display": "var(--font-playfair), Georgia, 'Times New Roman', serif",
    "sans": "var(--font-inter), system-ui, -apple-system, 'Segoe UI', sans-serif"
  },

  "text": {
    "$description": "Escala tipográfica fluida: [tamaño, interlineado]. Genera clases text-hero, text-display-1, etc.",
    "hero": ["clamp(3rem, 1.6rem + 6vw, 6.75rem)", "1.02"],
    "display-1": ["clamp(2.5rem, 1.6rem + 3.6vw, 4.5rem)", "1.06"],
    "display-2": ["clamp(2rem, 1.4rem + 2.4vw, 3.25rem)", "1.1"],
    "display-3": ["clamp(1.5rem, 1.2rem + 1.2vw, 2.125rem)", "1.2"],
    "title": ["1.375rem", "1.3"],
    "lead": ["clamp(1.125rem, 1rem + 0.45vw, 1.375rem)", "1.6"],
    "body": ["1.0625rem", "1.7"],
    "small": ["0.9375rem", "1.6"],
    "eyebrow": ["0.8125rem", "1.4"]
  },

  "tracking": {
    "eyebrow": "0.28em",
    "wordmark": "0.02em"
  },

  "layout": {
    "container": "80rem",
    "prose": "42rem",
    "gutter": "clamp(1.25rem, 0.5rem + 3.5vw, 3rem)",
    "section": "clamp(4.5rem, 2.5rem + 8vw, 9rem)",
    "header": "5.5rem"
  },

  "radius": {
    "control": "0px",
    "card": "0px"
  },

  "focus": {
    "width": "2px",
    "offset": "3px"
  },

  "motion": {
    "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)",
    "fast": "150ms",
    "base": "300ms",
    "slow": "700ms"
  }
}
