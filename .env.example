# Copiar como .env.local para desarrollo. En Vercel: Settings → Environment Variables.

# URL canónica del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=https://stratus.pe

# "true" SOLO en Producción el día del lanzamiento. Cualquier otro valor = noindex.
SITE_INDEXABLE=false

# ID de medición de GA4 (Fase 5). Vacío = analítica desactivada.
NEXT_PUBLIC_GA_ID=
